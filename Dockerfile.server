# Hosted service only: widget intake, dashboard, GitHub dispatch. No browser inside, because replays run in each
# team's own GitHub Actions. Small enough for free tiers (Render, Koyeb, a small Nebius VM).
FROM node:22-slim AS dashboard
WORKDIR /app/dashboard
COPY dashboard/package.json dashboard/package-lock.json ./
RUN npm ci --no-audit --no-fund
COPY dashboard/ ./
RUN npm run build

FROM python:3.13-slim
COPY --from=ghcr.io/astral-sh/uv:0.10.9 /uv /usr/local/bin/uv
WORKDIR /app
ENV UV_COMPILE_BYTECODE=1 UV_LINK_MODE=copy UV_PYTHON_DOWNLOADS=never PYTHONUNBUFFERED=1 START_LIVE_SHOP=0
COPY pyproject.toml uv.lock README.md .python-version ./
RUN uv sync --frozen --no-dev --no-install-project --extra postgres
COPY replay/ replay/
COPY server/ server/
COPY badshop/ badshop/
RUN uv sync --frozen --no-dev --extra postgres
COPY --from=dashboard /app/dashboard/dist dashboard/dist
RUN useradd --create-home app && mkdir -p results && chown -R app results
USER app
EXPOSE 8200
CMD ["sh", "-c", ".venv/bin/uvicorn server.app:app --host 0.0.0.0 --port ${PORT:-8200} --proxy-headers"]
