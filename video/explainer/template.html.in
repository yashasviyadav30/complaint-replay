<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=1920, height=1080" />
    <script src="https://cdn.jsdelivr.net/npm/gsap@3.14.2/dist/gsap.min.js"></script>
    <style>
      @font-face { font-family: "Geist"; src: url("assets/fonts/geist-latin-wght-normal.woff2") format("woff2"); font-weight: 100 900; }
      @font-face { font-family: "Geist Mono"; src: url("assets/fonts/geist-mono-latin-wght-normal.woff2") format("woff2"); font-weight: 100 900; }
      :root { --bg: #0c0d0f; --surface: #141619; --line: #2a2e34; --text: #e9eaec; --muted: #9ba1a8; --accent: #ff7043; --ok: #46d394; }
      * { margin: 0; padding: 0; box-sizing: border-box; }
      html, body { width: 1920px; height: 1080px; overflow: hidden; background: var(--bg); }
      #root { position: relative; width: 1920px; height: 1080px; font-family: "Geist", sans-serif; color: var(--text); }

      /* Product footage and screenshots sit in one frame; subtitles live in the band below, never over the product. */
      .footage, .frame { position: absolute; left: 160px; top: 24px; width: 1600px; height: 900px; border: 1px solid var(--line);
                         border-radius: 14px; background: #f4f5f6; overflow: hidden; }
      .footage { object-fit: cover; }
      .frame img { display: block; width: 100%; height: 100%; object-fit: cover; object-position: top; transform-origin: 70% 30%; }

      .sub { position: absolute; left: 160px; top: 944px; width: 1600px; height: 120px; text-align: center;
             font-size: 34px; line-height: 1.3; font-weight: 500; letter-spacing: -0.005em; padding: 12px 40px 0; }

      .slide { position: absolute; left: 0; top: 0; width: 1920px; height: 930px; display: flex; flex-direction: column;
               justify-content: center; padding: 0 200px; }
      .kicker { font-family: "Geist Mono", monospace; font-size: 28px; color: var(--accent); margin-bottom: 32px; }
      .big { font-size: 128px; font-weight: 650; letter-spacing: -0.04em; line-height: 1.02; }
      .mid { font-size: 88px; font-weight: 650; letter-spacing: -0.03em; line-height: 1.05; }
      .quote { font-size: 88px; font-weight: 600; letter-spacing: -0.03em; line-height: 1.1; }
      .lede { font-size: 40px; color: var(--muted); margin-top: 28px; line-height: 1.3; max-width: 1500px; }
      .stat-line { font-size: 40px; margin-top: 40px; color: var(--muted); }
      .stat-line b { font-size: 72px; color: var(--accent); font-weight: 650; margin-right: 16px; letter-spacing: -0.03em; }
      .stat-line span { font-family: "Geist Mono", monospace; font-size: 26px; }
      .link { font-family: "Geist Mono", monospace; font-size: 38px; color: var(--accent); margin-top: 48px; }

      .steps, .users { list-style: none; display: flex; flex-direction: column; gap: 22px; }
      .row { display: grid; grid-template-columns: 560px 1fr; gap: 32px; align-items: baseline; padding-bottom: 18px;
             border-bottom: 1px solid var(--line); }
      .row b { font-size: 42px; font-weight: 600; letter-spacing: -0.02em; }
      .row span { font-size: 34px; color: var(--muted); line-height: 1.3; }
      .steps .row b { color: var(--accent); }

      .cols { display: grid; grid-template-columns: repeat(3, 1fr); gap: 36px; }
      .col { display: flex; flex-direction: column; gap: 18px; padding: 40px; border: 1px solid var(--line); border-radius: 18px;
             background: var(--surface); }
      .col b { font-size: 44px; font-weight: 600; letter-spacing: -0.02em; margin-bottom: 8px; }
      .col span { font-size: 32px; color: var(--muted); line-height: 1.3; }

      .chips { list-style: none; display: flex; flex-wrap: wrap; gap: 18px; margin-top: 48px; }
      .chip { font-family: "Geist Mono", monospace; font-size: 30px; padding: 14px 24px; border: 1px solid var(--accent);
              border-radius: 999px; color: var(--text); }

      .flow { display: grid; grid-template-columns: 1.5fr 1fr 1fr 1fr; gap: 32px; align-items: center; }
      .bubbles { display: flex; flex-direction: column; gap: 16px; }
      .bubbles p { font-size: 28px; padding: 18px 22px; border-radius: 18px 18px 18px 4px; background: var(--surface);
                   border: 1px solid var(--line); line-height: 1.3; }
      .box { display: flex; flex-direction: column; gap: 12px; padding: 32px; border: 1px solid var(--line); border-radius: 18px;
             background: var(--surface); min-height: 220px; justify-content: center; }
      .box b { font-size: 36px; font-weight: 600; letter-spacing: -0.02em; line-height: 1.15; }
      .box span { font-size: 28px; color: var(--muted); }
      .badge { display: inline-block; align-self: flex-start; font-family: "Geist Mono", monospace; font-size: 34px;
               background: var(--accent); color: #1a0a04; padding: 8px 18px; border-radius: 999px; }

      .stats { display: grid; grid-template-columns: repeat(4, 1fr); gap: 48px; margin-top: 24px; }
      .stat .n { font-size: 128px; font-weight: 650; letter-spacing: -0.04em; font-variant-numeric: tabular-nums; }
      .stat .l { font-size: 32px; color: var(--muted); margin-top: 8px; }
      .stat.ok .n { color: var(--ok); }

      .todo { margin-top: 48px; padding: 32px 40px; border: 1px solid var(--accent); border-radius: 18px; display: flex;
              flex-direction: column; gap: 10px; }
      .todo b { font-size: 36px; color: var(--accent); font-weight: 600; }
      .todo span { font-size: 34px; }
    </style>
  </head>
  <body>
    <div id="root" data-composition-id="main" data-start="0" data-duration="{{DURATION}}" data-width="1920" data-height="1080">
{{BODY}}
    </div>
    <script>
      window.__timelines = window.__timelines || {};
      const tl = gsap.timeline({ paused: true });
      const rise = (sel, at) => tl.fromTo(sel, { opacity: 0, y: 18 }, { opacity: 1, y: 0, duration: 0.5, ease: "power2.out" }, at);
      {{ANIMS}}
      window.__timelines["main"] = tl;
      tl.seek(0);
    </script>
  </body>
</html>
