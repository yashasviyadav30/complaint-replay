# Nebius Token Factory (https://tokenfactory.nebius.com)
NEBIUS_API_KEY=
NEBIUS_BASE_URL=https://api.tokenfactory.nebius.com/v1/
# Free alternative for development (no card): key from build.nvidia.com, starts with nvapi-
# Used only when NEBIUS_API_KEY is empty. The hackathon submission must call Token Factory.
NVIDIA_API_KEY=
# Leave empty to auto-pick a Nemotron model from the live catalog
REPLAY_MODEL=
# Hard stop per run, so a looping agent can't run up a bill
REPLAY_TOKEN_BUDGET=2000000
